# Copy to .env and fill in. Without a key, clips are picked by a basic built-in picker.
ANTHROPIC_API_KEY=
# claude-opus-5 (default, best picks) or claude-haiku-4-5 (cheaper)
CLAUDE_MODEL=claude-opus-5
# auto = medium on GPU, small on CPU. Or: tiny, base, small, medium, large-v3
WHISPER_MODEL=auto
# Unclaimed jobs are deleted after this many hours
JOB_TTL_HOURS=24
